    "service_configuration_instructions": {
      "value": "# Environment Variables for Shopping Cart Service\nexport RABBITMQ_HOST=\"172.31.29.150\"\nexport RABBITMQ_PORT=\"5672\"\nexport RABBITMQ_USERNAME=\"admin\"\nexport RABBITMQ_PASSWORD=\"ChangeMe123!\"\n\n# Environment Variables for Warehouse Service\nexport SPRING_RABBITMQ_HOST=\"172.31.29.150\"\nexport SPRING_RABBITMQ_PORT=\"5672\"\nexport SPRING_RABBITMQ_USERNAME=\"admin\"\nexport SPRING_RABBITMQ_PASSWORD=\"ChangeMe123!\"\n\n# Access RabbitMQ Management Console\nManagement URL: http://54.244.209.76:15672\nUsername: admin\nPassword: ChangeMe123!\n\n# SSH into RabbitMQ Server\nssh -i \u003cyour-key.pem\u003e ec2-user@54.244.209.76\n\n# Check RabbitMQ Status\nssh -i \u003cyour-key.pem\u003e ec2-user@54.244.209.76 \"sudo rabbitmqctl status\"\n\n# List Queues\nssh -i \u003cyour-key.pem\u003e ec2-user@54.244.209.76 \"sudo rabbitmqctl list_queues\"\n",
      "type": "string",
      "sensitive": true
    },
    "shopping_cart_service_endpoint": {
      "value": "http://ecommerce-alb-1098412405.us-west-2.elb.amazonaws.com/shopping-cart",
