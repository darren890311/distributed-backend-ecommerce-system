    "shopping_cart_service_tg_name": {
      "value": "shopping-cart-service-tg",
      "type": "string"
    },
    "test_commands": {
      "value": "# Set ALB DNS as environment variable\nexport ALB_DNS=\"ecommerce-alb-1098412405.us-west-2.elb.amazonaws.com\"\n\n# Test Product Service\ncurl http://$ALB_DNS/products\ncurl http://$ALB_DNS/products/1\ncurl -H \"X-Service-Type: product\" http://$ALB_DNS/products/1\n\n# Test Shopping Cart Service\ncurl -X POST http://$ALB_DNS/shopping-cart -H \"Content-Type: application/json\" -d '{\"customer_id\": 123}'\ncurl -H \"X-Service-Type: cart\" http://$ALB_DNS/shopping-cart/1\n\n# Test Credit Card Authorizer\ncurl -X POST http://$ALB_DNS/credit-card-authorizer/authorize -H \"Content-Type: application/json\" -d '{\"credit_card_number\": \"1234-5678-9012-3456\"}'\ncurl -H \"X-Service-Type: payment\" http://$ALB_DNS/credit-card-authorizer/authorize\n\n# Check ALB Health\naws elbv2 describe-target-health --target-group-arn arn:aws:elasticloadbalancing:us-west-2:590183802817:targetgroup/product-service-tg/91b09e7d15586f9e\naws elbv2 describe-target-health --target-group-arn arn:aws:elasticloadbalancing:us-west-2:590183802817:targetgroup/shopping-cart-service-tg/b4dd86764b015f48\naws elbv2 describe-target-health --target-group-arn arn:aws:elasticloadbalancing:us-west-2:590183802817:targetgroup/credit-card-service-tg/51ffb48a14881820\n",
      "type": "string"
    },
